rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.preferredLanguage in ['en', 'hi', 'hinglish'] &&
             data.mood in ['Focused', 'Chill', 'Study', 'Energized'] &&
             data.voiceEnabled is bool &&
             data.ttsSpeechRate is number && data.ttsSpeechRate >= 0.5 && data.ttsSpeechRate <= 2.0 &&
             data.backgroundAssistantEnabled is bool &&
             data.cityName is string && data.cityName.size() <= 80 &&
             data.memorySummary is string && data.memorySummary.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
             data.language in ['en', 'hi'] &&
             (!('actionTag' in data) || (data.actionTag is string && data.actionTag.size() <= 64)) &&
             data.hasImage is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidReminder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.timeLabel is string && data.timeLabel.size() <= 40 &&
             data.category in ['Alarm', 'Reminder', 'Study', 'Music'] &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredLanguage', 'mood',
                         'voiceEnabled', 'ttsSpeechRate', 'backgroundAssistantEnabled',
                         'cityName', 'memorySummary', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'preferredLanguage', 'mood',
                         'voiceEnabled', 'ttsSpeechRate', 'backgroundAssistantEnabled',
                         'cityName', 'memorySummary', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredLanguage', 'mood',
                         'voiceEnabled', 'ttsSpeechRate', 'backgroundAssistantEnabled',
                         'cityName', 'memorySummary', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'role', 'text', 'language', 'hasImage', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'text', 'language', 'actionTag', 'hasImage', 'createdAt']) &&
                         isValidChatMessage(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'timeLabel', 'category',
                           'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'timeLabel', 'category',
                           'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidReminder(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidReminder(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'timeLabel', 'category', 'completed', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(reminderId);
      }
    }
  }
}
